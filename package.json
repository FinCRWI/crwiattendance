{
  "name": "crwi-attendance-app",
  "version": "1.0.0",
  "private": true,
  "description": "Automation tooling for linting and smoke testing",
  "scripts": {
    "predev": "node scripts/generate-build-assets.cjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-build-assets.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"js/**/*.js\" \"tests/**/*.js\" \"tests/**/*.mjs\"",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:smoke": "playwright test",
    "test": "npm run lint && npm run test:unit && npm run test:smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.51.0",
    "eslint": "^9.21.0",
    "globals": "^15.15.0",
    "playwright": "^1.51.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "dotenv": "^17.4.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "node-fetch": "^2.7.0"
  }
}
